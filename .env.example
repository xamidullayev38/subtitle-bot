# Telegram Bot Token (BotFather dan olinadi)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# Telegram API ID va API HASH (https://my.telegram.org saytidan olinadi)
# Bu 1 GB - 2 GB gacha fayllarni yuklash/yuklab olish uchun zarur
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Kinolarni saqlash uchun yopiq kanal (Storage/Dump Channel ID)
# Masalan: -1001234567890 (Bot bu kanalda Admin bo'lishi shart)
STORAGE_CHANNEL_ID=-1001234567890

# Bot egasi / Admin ID (Telegram ID)
ADMIN_ID=123456789
